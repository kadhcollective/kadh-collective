# ============================================================
#  KADH Collective — environment variables reference
#  Copy this file to .env (NEVER commit .env to git)
#
#  Most of these live in Supabase, not locally.
#  Local .env is only for testing scripts/email.js or running
#  edge functions with the Supabase CLI.
# ============================================================

# ─── Supabase ─────────────────────────────────────────────
# Public anon key (safe to expose; baked into index.html)
SUPABASE_URL=https://nlgavsmgnxrkrwbyonxr.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service-role key (server only — used by edge functions; NEVER ship to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Stripe ───────────────────────────────────────────────
# Publishable key — stored in site_settings.stripe_publishable_key
# (this var is just for local testing; production reads from DB)
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret key — Supabase Edge Function Secret named STRIPE_SECRET_KEY
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret — Supabase Edge Function Secret named STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend ───────────────────────────────────────────────
# API key — stored in site_settings.resend_api_key (admin manages it)
RESEND_API_KEY=re_...
# Sender email — stored in site_settings.from_email
KADH_FROM_EMAIL=orders@kadhcollective.com
KADH_SHOP_URL=https://kadhcollective.com

# ─── EasyParcel (when integrated) ─────────────────────────
EP_API_KEY=
EP_SANDBOX=true
